# ── AI ───────────────────────────────────────────────────────────────
# Vercel AI Gateway (https://vercel.com/ai-gateway). On Vercel, or locally
# after `vercel env pull`, the project's OIDC token is used automatically and
# this can be left empty.
AI_GATEWAY_API_KEY=
# Optional: any AI Gateway model id (default: openai/gpt-5, as in lead-agent)
AI_MODEL=

# ── Research ─────────────────────────────────────────────────────────
# Exa (https://exa.ai). If unset, the research step is skipped and prospects
# are qualified on detection + performance evidence only.
EXA_API_KEY=

# ── Performance ──────────────────────────────────────────────────────
# Google PageSpeed Insights API key (Google Cloud console → APIs → PageSpeed
# Insights API → Credentials). Keyless quota is ~0 in practice.
PSI_API_KEY=

# ── Storage ──────────────────────────────────────────────────────────
# Neon Postgres via Vercel Marketplace (free plan). Injected automatically
# when the integration is connected. If unset in local dev, an embedded
# PGlite database in ./.pglite is used instead.
DATABASE_URL=

# ── Slack human-in-the-loop (optional) ───────────────────────────────
# Create the app from manifest.json. If unset, approve from the dashboard.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=

# ── App ──────────────────────────────────────────────────────────────
# Required in production: authorizes starting runs and dashboard approvals.
RUN_SECRET=
# Name used to sign drafts (fills {{rep_name}})
REP_NAME=
# Public URL used for links in Slack (defaults to the Vercel production URL)
APP_URL=
