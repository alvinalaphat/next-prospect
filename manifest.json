{
  "display_information": {
    "name": "Next Prospect",
    "description": "Grounded outbound drafts for human approval",
    "background_color": "#000000"
  },
  "features": {
    "bot_user": {
      "display_name": "Next Prospect",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["chat:write"]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://nextprospect.vercel.app/api/slack"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
